#:kivy 2.3.1
# =====================================================================
#  MoneyFan · interfaz.kv
# ---------------------------------------------------------------------
#  [QUÉ HACE ESTE ARCHIVO]
#  Describe CÓMO SE VE la app usando el lenguaje "kv" de Kivy + los
#  componentes de KivyMD (Material Design). La lógica está en main.py.
#
#  Estructura:
#    SECCIÓN 1 · Componentes reutilizables (tarjetas, filas, botones)
#    SECCIÓN 2 · Pantalla de ingreso (RUT + contraseña)
#    SECCIÓN 3 · PANTALLA 1 · Home (suma diaria + agregar microgasto)
#    SECCIÓN 4 · PANTALLA 2 · Gráficos (diario / semanal / mensual)
#    SECCIÓN 5 · Raíz: barra de estado del "teléfono" + gestor de pantallas
#
#  Los colores vienen de la paleta en config.py (app.c_primario, etc.)
# =====================================================================
#:import dp kivy.metrics.dp
#:import SlideTransition kivy.uix.screenmanager.SlideTransition


# =====================================================================
# [SECCIÓN 1] COMPONENTES REUTILIZABLES
# =====================================================================

# [1.1] Tarjeta blanca con bordes redondeados y borde suave
<TarjetaSuave@MDCard>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(16)
    spacing: dp(8)
    radius: [dp(18)]
    elevation: 0
    md_bg_color: app.c_tarjeta
    line_color: app.c_borde

# [1.2] Título de sección dentro de una tarjeta
<TituloTarjeta@MDLabel>:
    font_style: "Subtitle1"
    bold: True
    adaptive_height: True
    theme_text_color: "Custom"
    text_color: app.c_texto

# [1.3] Texto pequeño y gris (ayudas, descripciones)
<TextoAyuda@MDLabel>:
    font_style: "Caption"
    adaptive_height: True
    theme_text_color: "Custom"
    text_color: app.c_texto_suave

# [1.4] Mensaje para listas vacías
<TextoVacio>:
    font_style: "Body2"
    halign: "center"
    size_hint_y: None
    height: dp(40)
    theme_text_color: "Custom"
    text_color: app.c_texto_suave

# [1.5] Campo de texto con el estilo de la app
<CampoMF@MDTextField>:
    mode: "rectangle"
    helper_text_mode: "on_error"
    line_color_focus: app.c_primario
    hint_text_color_focus: app.c_primario
    icon_left_color_focus: app.c_primario
    text_color_focus: app.c_texto
    error_color: app.c_error

# [1.6] Barra de estado falsa del teléfono (hora, señal, batería)
<BarraEstado>:
    size_hint_y: None
    height: dp(26)
    padding: [dp(18), 0, dp(14), 0]
    spacing: dp(4)
    md_bg_color: app.c_primario
    MDLabel:
        text: root.hora
        font_style: "Caption"
        bold: True
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
    MDIcon:
        icon: "signal-cellular-3"
        font_size: "15sp"
        size_hint_x: None
        width: dp(18)
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
    MDIcon:
        icon: "wifi"
        font_size: "15sp"
        size_hint_x: None
        width: dp(18)
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
    MDIcon:
        icon: "battery-80"
        font_size: "15sp"
        size_hint_x: None
        width: dp(18)
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1

# [1.7] Fila de un microgasto (icono de categoría + texto + monto)
<FilaGasto>:
    size_hint_y: None
    height: dp(58)
    spacing: dp(12)
    padding: [0, dp(6)]
    on_release: app.mostrar_boleta(root.gasto) if root.gasto else None
    # Círculo de color con el icono de la categoría
    MDIcon:
        icon: root.icono
        font_size: "20sp"
        halign: "center"
        valign: "center"
        text_size: self.size
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: root.color_icono
        canvas.before:
            Color:
                rgba: root.color_icono[0], root.color_icono[1], root.color_icono[2], .18
            Ellipse:
                pos: self.pos
                size: self.size
    # Descripción + comercio/hora
    MDBoxLayout:
        orientation: "vertical"
        MDLabel:
            text: root.titulo
            font_style: "Body1"
            bold: True
            shorten: True
            shorten_from: "right"
            theme_text_color: "Custom"
            text_color: app.c_texto
        MDLabel:
            text: root.subtitulo
            font_style: "Caption"
            shorten: True
            theme_text_color: "Custom"
            text_color: app.c_texto_suave
    # Monto + icono del origen (Gmail o manual)
    MDBoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: dp(80)
        MDLabel:
            text: root.monto_txt
            halign: "right"
            bold: True
            theme_text_color: "Custom"
            text_color: app.c_primario
        MDIcon:
            icon: root.origen_icono
            font_size: "14sp"
            halign: "right"
            text_size: self.size
            theme_text_color: "Custom"
            text_color: app.c_texto_suave

# [1.8] Fila de la leyenda del gráfico de dona
<FilaLeyenda>:
    size_hint_y: None
    height: dp(26)
    spacing: dp(8)
    MDBoxLayout:
        size_hint: None, None
        size: dp(12), dp(12)
        pos_hint: {"center_y": .5}
        md_bg_color: root.color
        radius: [dp(3)]
    MDLabel:
        text: root.texto
        font_style: "Caption"
        bold: True
        theme_text_color: "Custom"
        text_color: app.c_texto
    MDLabel:
        text: root.valor_txt
        font_style: "Caption"
        halign: "right"
        theme_text_color: "Custom"
        text_color: app.c_texto_suave

# [1.9] Botón de la barra inferior
<BotonNav>:
    orientation: "vertical"
    padding: [0, dp(8), 0, dp(6)]
    MDIcon:
        icon: root.icono
        halign: "center"
        font_size: "24sp"
        size_hint: None, None
        size: dp(28), dp(28)
        pos_hint: {"center_x": .5}
        theme_text_color: "Custom"
        text_color: app.c_primario if root.activo else app.c_texto_suave
    MDLabel:
        text: root.texto
        halign: "center"
        font_style: "Caption"
        bold: root.activo
        theme_text_color: "Custom"
        text_color: app.c_primario if root.activo else app.c_texto_suave

# [1.10] Barra de navegación inferior (Pantalla 1 <-> Pantalla 2)
<BarraNavegacion>:
    size_hint_y: None
    height: dp(62)
    md_bg_color: app.c_tarjeta
    canvas.before:
        Color:
            rgba: app.c_borde
        Rectangle:
            pos: self.x, self.top - dp(1)
            size: self.width, dp(1)
    BotonNav:
        icono: "home-variant-outline"
        texto: "Inicio"
        activo: root.activa == "home"
        on_release: app.ir_a("home")
    BotonNav:
        icono: "chart-box-outline"
        texto: "Gráficos"
        activo: root.activa == "graficos"
        on_release: app.ir_a("graficos")

# [1.11] Botón tipo pestaña (Diario / Semanal / Mensual)
<BotonSegmento>:
    canvas.before:
        Color:
            rgba: app.c_primario if root.activo else app.c_tarjeta
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
    MDLabel:
        text: root.texto
        halign: "center"
        bold: True
        font_style: "Body2"
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.activo else app.c_secundario


# =====================================================================
# [SECCIÓN 2] PANTALLA DE INGRESO (RUT + CONTRASEÑA)
# =====================================================================
<LoginScreen>:
    md_bg_color: app.c_fondo
    MDBoxLayout:
        orientation: "vertical"
        padding: [dp(28), dp(36), dp(28), dp(24)]
        spacing: dp(24)

        Widget:
            size_hint_y: .25

        # [2.1] Logo y nombre de la app
        MDIcon:
            icon: "piggy-bank-outline"
            font_size: "76sp"
            halign: "center"
            size_hint: None, None
            size: dp(84), dp(84)
            pos_hint: {"center_x": .5}
            theme_text_color: "Custom"
            text_color: app.c_primario
        MDLabel:
            text: "MoneyFan"
            font_style: "H4"
            bold: True
            halign: "center"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: app.c_primario
        MDLabel:
            text: "Tus microgastos, bajo control"
            halign: "center"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: app.c_texto_suave

        Widget:
            size_hint_y: None
            height: dp(12)

        # [2.2] Campo RUT (solo acepta dígitos, puntos, guion y K)
        CampoMF:
            id: rut
            hint_text: "RUT (ej: 12.345.678-9)"
            icon_left: "card-account-details-outline"
            input_filter: app.filtro_rut
            max_text_length: 12
            write_tab: False
            on_focus: root.on_rut_focus(args[1])
            on_text_validate: clave.focus = True

        # [2.3] Campo contraseña (exactamente 6 caracteres)
        CampoMF:
            id: clave
            hint_text: "Contraseña (6 caracteres)"
            icon_left: "lock-outline"
            password: True
            max_text_length: 6
            write_tab: False
            on_text_validate: root.ingresar()

        # [2.4] Mensaje de error general (usuario no encontrado)
        MDLabel:
            id: error_login
            text: ""
            halign: "center"
            font_style: "Caption"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: app.c_error

        # [2.5] Botón ingresar
        MDRaisedButton:
            text: "INGRESAR"
            size_hint_x: 1
            md_bg_color: app.c_primario
            font_size: "16sp"
            padding: [0, dp(14)]
            on_release: root.ingresar()

        # [2.6] Ayuda con las credenciales demo
        TextoAyuda:
            text: "Demo: RUT 12.345.678-9  ·  clave 123456"
            halign: "center"

        Widget:


# =====================================================================
# [SECCIÓN 3] PANTALLA 1 · HOME
# =====================================================================
<HomeScreen>:
    md_bg_color: app.c_fondo
    MDBoxLayout:
        orientation: "vertical"

        # [3.1] Barra superior con saludo, botón de prueba del aviso y salir
        MDTopAppBar:
            title: "Hola, " + app.nombre_usuario
            elevation: 0
            md_bg_color: app.c_primario
            specific_text_color: 1, 1, 1, 1
            right_action_items:
                [["bell-ring-outline", lambda x: app.mostrar_aviso_diario(), "Probar aviso 20:00"], \
                ["logout", lambda x: app.cerrar_sesion(), "Cerrar sesión"]]

        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            MDBoxLayout:
                orientation: "vertical"
                padding: dp(14)
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height

                # [3.2] TARJETA PRINCIPAL: suma diaria + semana + mes
                TarjetaSuave:
                    md_bg_color: app.c_primario
                    line_color: app.c_primario
                    padding: dp(20)
                    MDLabel:
                        text: "Gastado hoy · " + app.txt_fecha_hoy
                        font_style: "Caption"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, .8
                    MDLabel:
                        text: app.txt_total_hoy
                        font_style: "H3"
                        bold: True
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                    MDLabel:
                        text: app.txt_cant_hoy
                        font_style: "Body2"
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: app.c_acento2
                    Widget:
                        size_hint_y: None
                        height: dp(6)
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(10)
                        # Mini resumen semanal
                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            padding: dp(10)
                            radius: [dp(12)]
                            md_bg_color: 1, 1, 1, .1
                            MDLabel:
                                text: "Esta semana"
                                font_style: "Caption"
                                adaptive_height: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, .75
                            MDLabel:
                                text: app.txt_total_semana
                                font_style: "H6"
                                bold: True
                                adaptive_height: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1
                        # Mini resumen mensual
                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            padding: dp(10)
                            radius: [dp(12)]
                            md_bg_color: 1, 1, 1, .1
                            MDLabel:
                                text: "Este mes"
                                font_style: "Caption"
                                adaptive_height: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, .75
                            MDLabel:
                                text: app.txt_total_mes
                                font_style: "H6"
                                bold: True
                                adaptive_height: True
                                theme_text_color: "Custom"
                                text_color: 1, 1, 1, 1

                # [3.3] TARJETA GMAIL (simulado): conectar / sincronizar
                TarjetaSuave:
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "gmail"
                            font_size: "30sp"
                            size_hint: None, None
                            size: dp(36), dp(36)
                            pos_hint: {"center_y": .5}
                            theme_text_color: "Custom"
                            text_color: app.c_error
                        MDBoxLayout:
                            orientation: "vertical"
                            adaptive_height: True
                            TituloTarjeta:
                                text: "Boletas desde Gmail" + (" · conectado" if app.gmail_conectado else "")
                            TextoAyuda:
                                text: app.txt_estado_gmail
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(8)
                        MDRaisedButton:
                            text: "SINCRONIZAR" if app.gmail_conectado else "CONECTAR GMAIL"
                            md_bg_color: app.c_secundario
                            on_release: app.accion_gmail()
                        MDFlatButton:
                            text: "DESCONECTAR"
                            theme_text_color: "Custom"
                            text_color: app.c_error
                            opacity: 1 if app.gmail_conectado else 0
                            disabled: not app.gmail_conectado
                            on_release: app.desconectar_gmail()

                # [3.4] TARJETA AGREGAR MICROGASTO MANUAL (compras en efectivo)
                TarjetaSuave:
                    spacing: dp(20)
                    TituloTarjeta:
                        text: "Agregar microgasto manual"
                    TextoAyuda:
                        text: "Para compras en efectivo o sin boleta electrónica."
                    CampoMF:
                        id: descripcion
                        hint_text: "Descripción (ej: Galletas)"
                        icon_left: "text-box-outline"
                        max_text_length: 30
                        write_tab: False
                    CampoMF:
                        id: monto
                        hint_text: "Monto en pesos (entero, sin puntos)"
                        icon_left: "currency-usd"
                        input_filter: app.filtro_digitos
                        max_text_length: 6
                        write_tab: False
                    CampoMF:
                        id: categoria
                        hint_text: "Categoría"
                        icon_left: "shape-outline"
                        icon_right: "chevron-down"
                        readonly: True
                        on_focus: if args[1]: root.abrir_menu_categorias()
                    Widget:
                        size_hint_y: None
                        height: dp(4)
                    MDRaisedButton:
                        text: "AGREGAR MICROGASTO"
                        size_hint_x: 1
                        md_bg_color: app.c_primario
                        on_release: root.agregar_gasto()

                # [3.5] TARJETA "MICROGASTOS DE HOY"
                TarjetaSuave:
                    TituloTarjeta:
                        text: "Microgastos de hoy"
                    TextoAyuda:
                        text: "Toca uno para ver su boleta. " + app.txt_proximo_aviso
                    MDBoxLayout:
                        id: lista_hoy
                        orientation: "vertical"
                        adaptive_height: True

        # [3.6] Navegación inferior
        BarraNavegacion:
            activa: "home"


# =====================================================================
# [SECCIÓN 4] PANTALLA 2 · GRÁFICOS
# =====================================================================
<GraficosScreen>:
    md_bg_color: app.c_fondo
    MDBoxLayout:
        orientation: "vertical"

        # [4.1] Barra superior
        MDTopAppBar:
            title: "Mis gráficos"
            elevation: 0
            md_bg_color: app.c_primario
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: app.ir_a("home")]]

        # [4.2] Selector de periodo: Diario / Semanal / Mensual
        MDBoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: [dp(14), dp(10)]
            MDBoxLayout:
                padding: dp(4)
                spacing: dp(4)
                radius: [dp(14)]
                md_bg_color: app.c_tarjeta
                line_color: app.c_borde
                BotonSegmento:
                    texto: "Diario"
                    activo: root.periodo == "diario"
                    on_release: root.cambiar_periodo("diario")
                BotonSegmento:
                    texto: "Semanal"
                    activo: root.periodo == "semanal"
                    on_release: root.cambiar_periodo("semanal")
                BotonSegmento:
                    texto: "Mensual"
                    activo: root.periodo == "mensual"
                    on_release: root.cambiar_periodo("mensual")

        ScrollView:
            do_scroll_x: False
            bar_width: dp(3)
            MDBoxLayout:
                orientation: "vertical"
                padding: [dp(14), 0, dp(14), dp(14)]
                spacing: dp(14)
                size_hint_y: None
                height: self.minimum_height

                # [4.3] Total del periodo
                TarjetaSuave:
                    spacing: dp(2)
                    TextoAyuda:
                        text: root.txt_titulo
                    MDLabel:
                        text: root.txt_total
                        font_style: "H4"
                        bold: True
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: app.c_primario
                    TextoAyuda:
                        text: root.txt_detalle

                # [4.4] Gráfico de barras (cada microgasto / cada día)
                TarjetaSuave:
                    TituloTarjeta:
                        text: root.txt_titulo_barras
                    GraficoBarras:
                        id: barras
                        size_hint_y: None
                        height: dp(190)
                        color_barra: app.c_primario
                        color_destacado: app.c_acento2
                        color_texto: app.c_texto_suave
                        color_guia: app.c_borde

                # [4.5] Gráfico de dona por categoría + leyenda
                TarjetaSuave:
                    TituloTarjeta:
                        text: "Por categoría"
                    MDBoxLayout:
                        size_hint_y: None
                        height: max(dp(140), leyenda.height)
                        spacing: dp(12)
                        GraficoDona:
                            id: dona
                            size_hint_x: None
                            width: dp(140)
                            color_fondo: app.c_tarjeta
                            color_texto: app.c_texto
                            color_vacio: app.c_borde
                        MDBoxLayout:
                            id: leyenda
                            orientation: "vertical"
                            adaptive_height: True
                            pos_hint: {"center_y": .5}

                # [4.6] Lista de cada microgasto del periodo
                TarjetaSuave:
                    TituloTarjeta:
                        text: "Detalle de microgastos"
                    TextoAyuda:
                        text: "Toca uno para ver su documento de respaldo."
                    MDBoxLayout:
                        id: lista
                        orientation: "vertical"
                        adaptive_height: True

        # [4.7] Navegación inferior
        BarraNavegacion:
            activa: "graficos"


# =====================================================================
# [SECCIÓN 5] RAÍZ DE LA APP
# Barra de estado del "teléfono" arriba + gestor de pantallas abajo.
# =====================================================================
MDBoxLayout:
    orientation: "vertical"
    md_bg_color: app.c_fondo

    BarraEstado:

    MDScreenManager:
        id: sm
        transition: SlideTransition(duration=.25)
        LoginScreen:
            name: "login"
        HomeScreen:
            name: "home"
        GraficosScreen:
            name: "graficos"
